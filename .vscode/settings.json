{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/frontend/node_modules/**": true,
    "**/build/**": true,
    "**/frontend/dist/**": true,
    "**/.stuck.nosync/**": true,
    "**/*.nosync/**": true,
    "**/.vite/**": true,
    "**/cvmaker.db*": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/.stuck.nosync": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/frontend/node_modules": true,
    "**/build": true,
    "**/frontend/dist": true,
    "**/.stuck.nosync": true
  },
  "git.ignoreLimitWarning": true
}